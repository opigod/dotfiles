# KineticWE custom keybinds — generated by Kinetic Settings.
# Each entry adds one action to the Applications / Custom Commands
# keybinds categories; chords live in keybinds.kwe and the daemon.
[applications]
firefox-nightly=Firefox nightly
[applications:exec]
firefox-nightly=/opt/firefox-nightly/firefox
[custom-commands]
cmd-1=ghostty
[custom-commands:exec]
cmd-1=ghostty
